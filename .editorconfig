root = true

[*]
charset = utf-8
end_of_line = lf
indent_size = 2
indent_style = tab
insert_final_newline = true
trim_trailing_whitespace = true

[*.{js,jsx,ts,tsx}]
indent_style = space
max_line_length = 100

[*.{json,yaml,yml,toml}]
indent_style = space

[*.md]
trim_trailing_whitespace = false
indent_style = space
